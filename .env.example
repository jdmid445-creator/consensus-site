# --- AI (meta read + narrative writer) ---------------------------------
# console.anthropic.com → API keys. Without it the site still works: the board,
# themes and numbers show, and the AI read + narrative writer are switched off.
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Market data --------------------------------------------------------
# DexScreener needs no key. GeckoTerminal works keyless (about 5 calls/min);
# a free CoinGecko demo key makes it steadier.
COINGECKO_API_KEY=

# Holder data (top-10 share). Free plan at helius.dev
HELIUS_API_KEY=

# --- Remembering runners across days (recommended) ----------------------
# Vercel → Storage → Upstash (Redis), free plan. Fills these in automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- What counts as a runner (optional) ---------------------------------
# Launch-age windows in hours, widened in order until 50 qualify
RUNNER_WINDOWS_HOURS=72,120,168
RUNNER_MIN_MCAP=100000
RUNNER_MIN_LIQUIDITY=8000

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=Runners
NEXT_PUBLIC_SITE_URL=
# Fill in once the coin is live (shown in the footer, never in the hero)
NEXT_PUBLIC_TICKER=
NEXT_PUBLIC_CA=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# Solana Tracker data API: wallet PnL and names on the Whales tab (optional)
SOLANATRACKER_API_KEY=

# X tracker tab (optional). Set ONE of these and the "X tracker" tab appears.
# X_BEARER_TOKEN is the official X API; TWITTERAPI_IO_KEY is twitterapi.io (cheaper).
X_BEARER_TOKEN=
TWITTERAPI_IO_KEY=
# How often the feed re-reads X, in seconds. Every read costs API credits.
X_FEED_SECONDS=300
